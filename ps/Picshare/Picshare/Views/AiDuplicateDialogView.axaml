<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Picshare.ViewModels"
             x:Class="Picshare.Views.AiDuplicateDialogView"
             x:DataType="vm:MainViewModel">
  <Grid Background="#80000000" Focusable="True" KeyDown="Dialog_KeyDown">
    <Border Background="White" BorderBrush="#D6D8D1" BorderThickness="1"
            CornerRadius="6" Padding="18" Margin="20" MaxWidth="520"
            HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,*,Auto" MaxHeight="560">
        <TextBlock Text="Find duplicates with AI" FontSize="18" FontWeight="SemiBold"/>
        <ScrollViewer Grid.Row="1" Margin="0,12">
          <StackPanel Spacing="10">
            <TextBlock Text="Categories to include" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding AiDuplicateCategories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiDuplicateCategoryViewModel">
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Additional instructions (optional)" FontWeight="SemiBold"/>
            <TextBox x:Name="PromptTextBox" Text="{Binding AiDuplicatePrompt, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220"
                     Watermark="For example: keep different poses as separate photos."/>
            <TextBlock Text="Photos in these categories will be sent to the configured AI service."
                       TextWrapping="Wrap" Foreground="#6C756F"/>
            <TextBlock Text="{Binding AiDuplicateDialogMessage}" IsVisible="{Binding HasAiDuplicateDialogMessage}"
                       TextWrapping="Wrap" Foreground="#B42318"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelAiDuplicateDialogCommand}" Padding="12,8"/>
          <Button Content="OK" Command="{Binding FindAiDuplicatesCommand}" Padding="12,8"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
