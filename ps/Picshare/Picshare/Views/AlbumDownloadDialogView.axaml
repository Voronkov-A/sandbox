<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picshare.ViewModels"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="560"
             x:Class="Picshare.Views.AlbumDownloadDialogView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Button.album-download-control">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6D8D1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ComboBox.album-download-control">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6D8D1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.album-download-control">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6D8D1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="AlbumDownloadDialogOverlay"
        Background="#80000000"
        Focusable="True"
        KeyDown="AlbumDownloadDialogOverlay_KeyDown"
        PointerPressed="AlbumDownloadDialogOverlay_PointerPressed"
        IsVisible="{Binding IsAlbumDownloadDialogVisible}">
    <Border x:Name="AlbumDownloadDialog"
            Background="White"
            BorderBrush="#D6D8D1"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            Margin="20"
            MaxWidth="780"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            PointerPressed="AlbumDownloadDialog_PointerPressed">
      <Grid RowDefinitions="Auto,*,Auto" MaxHeight="560">
        <TextBlock Text="Download album" FontSize="18" FontWeight="SemiBold"/>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,12">
          <ItemsControl ItemsSource="{Binding AlbumDownloadCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumDownloadCategoryViewModel">
                <Border BorderBrush="#D6D8D1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Header}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Grid x:Name="AlbumDownloadRowGrid"
                          ColumnDefinitions="182,*,42"
                          ColumnSpacing="8"
                          SizeChanged="AlbumDownloadRowGrid_SizeChanged">
                      <ComboBox x:Name="AlbumDownloadModeComboBox"
                                Classes="album-download-control"
                                ItemsSource="{Binding ModeOptions}"
                                SelectedItem="{Binding SelectedMode}"
                                Height="42"
                                MinWidth="5"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:AlbumDownloadModeViewModel">
                            <TextBlock Text="{Binding Name}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       TextTrimming="CharacterEllipsis"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox x:Name="AlbumDownloadDestinationTextBox"
                               IsVisible="{Binding UsesLocalDownloadPaths}"
                               Classes="album-download-control"
                               Grid.Column="1"
                               Text="{Binding DestinationDirectoryPath}"
                               IsEnabled="{Binding IsDestinationDirectoryEnabled}"
                               Watermark="{Binding DestinationPathWatermark}"
                               Height="42"
                               MinWidth="5"
                               HorizontalAlignment="Stretch"
                               VerticalContentAlignment="Center"/>
                      <Button x:Name="AlbumDownloadDestinationSelectButton"
                              IsVisible="{Binding UsesLocalDownloadPaths}"
                              Classes="album-download-control"
                              Grid.Column="2"
                              Click="ChooseAlbumDownloadCategoryDestination_Click"
                              IsEnabled="{Binding IsDestinationDirectoryEnabled}"
                              MaxWidth="42"
                              Height="42"
                              MinWidth="5"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              ToolTip.Tip="{Binding DestinationSelectButtonText}">
                        <Canvas Width="22" Height="22">
                          <Path Data="M3,7 L8,7 L10,9 L19,9 L19,17 L3,17 Z"
                                Stroke="#27343B"
                                StrokeThickness="1.7"
                                Fill="Transparent"
                                StrokeJoin="Round"/>
                          <Path Data="M3,8 L3,5 L8,5 L10,7 L15,7"
                                Stroke="#27343B"
                                StrokeThickness="1.7"
                                Fill="Transparent"
                                StrokeJoin="Round"/>
                        </Canvas>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2"
              x:Name="AlbumDownloadActionHost"
              HorizontalAlignment="Stretch"
              SizeChanged="AlbumDownloadActionHost_SizeChanged">
          <StackPanel x:Name="AlbumDownloadActionPanel"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button x:Name="AlbumDownloadButton"
                    Classes="album-download-control"
                    Command="{Binding DownloadAlbumCommand}"
                    Height="42"
                    MinWidth="5"
                    Padding="12,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <TextBlock Text="Download"
                         TextAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CancelAlbumDownloadButton"
                    Classes="album-download-control"
                    Command="{Binding CancelAlbumDownloadDialogCommand}"
                    Height="42"
                    MinWidth="5"
                    Padding="12,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <TextBlock Text="Cancel"
                         TextAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
