<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picshare.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="700"
             x:Class="Picshare.Views.SidebarView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SidebarAlbumTemplate" x:DataType="vm:RecentAlbumViewModel">
      <Grid ColumnDefinitions="*,40" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
        <TextBlock Text="{Binding Title}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#27343B"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Width="34"
                Height="34"
                Padding="0"
                Click="CopyAlbumLink_Click"
                ToolTip.Tip="Copy link">
          <Canvas Width="20" Height="20">
            <Path Data="M7,4 L15,4 L15,13 L7,13 Z"
                  Stroke="#27343B"
                  StrokeThickness="1.6"
                  Fill="Transparent"/>
            <Path Data="M4,7 L12,7 L12,16 L4,16 Z"
                  Stroke="#27343B"
                  StrokeThickness="1.6"
                  Fill="Transparent"/>
            <Path Data="M12,8 L17,8 M15,6 L17,8 L15,10"
                  Stroke="#27343B"
                  StrokeThickness="1.6"
                  Fill="Transparent"/>
          </Canvas>
        </Button>
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding Description}"
                   FontSize="11"
                   Foreground="#6C756F"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Border Background="#66000000"
            PointerPressed="SidebarScrim_PointerPressed"/>
    <Border Width="320"
            MaxWidth="320"
            Background="#EEF2EF"
            BorderBrush="#C9D1CC"
            BorderThickness="0,0,1,0"
            HorizontalAlignment="Left">
      <Grid RowDefinitions="56,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Background="#27343B"
              Margin="0">
          <TextBlock Text="Picshare"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="White"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  Width="38"
                  Height="38"
                  Padding="0"
                  Margin="0,0,16,0"
                  Background="#FFFFFF"
                  Foreground="#27343B"
                  BorderBrush="#C9D1CC"
                  BorderThickness="1"
                  Command="{Binding CloseSidebarCommand}"
                  ToolTip.Tip="Close menu"
                  VerticalAlignment="Center">
            <TextBlock Text="X"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="8" Margin="12">
            <Button Command="{Binding ShowCurrentAlbumCommand}"
                    IsVisible="{Binding HasCurrentSidebarAlbum}"
                    Padding="12"
                    HorizontalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#C9D1CC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">
              <ContentControl Content="{Binding CurrentSidebarAlbum}"
                              ContentTemplate="{StaticResource SidebarAlbumTemplate}"/>
            </Button>

            <Button Command="{Binding ToggleCreateSidebarCommand}"
                    Padding="12,10"
                    HorizontalAlignment="Stretch"
                    Background="#FFFFFF"
                    Foreground="#27343B"
                    BorderBrush="#C9D1CC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Create"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text=">"
                           FontSize="16"
                           FontWeight="SemiBold"/>
              </Grid>
            </Button>
            <StackPanel Spacing="4"
                        Margin="16,0,0,0"
                        IsVisible="{Binding IsCreateSidebarExpanded}">
              <Button Command="{Binding ShowCreateLocalToGoogleDriveCommand}"
                      Padding="12,9"
                      HorizontalAlignment="Stretch"
                      Background="White"
                      BorderBrush="#C9D1CC"
                      BorderThickness="1"
                      HorizontalContentAlignment="Left">
                Local to Google Drive
              </Button>
              <Button Command="{Binding ShowCreateLocalAlbumCommand}"
                      Padding="12,9"
                      HorizontalAlignment="Stretch"
                      Background="White"
                      BorderBrush="#C9D1CC"
                      BorderThickness="1"
                      HorizontalContentAlignment="Left">
                Local to Local
              </Button>
            </StackPanel>

            <Button Command="{Binding ToggleOpenSidebarCommand}"
                    Padding="12,10"
                    HorizontalAlignment="Stretch"
                    Background="#FFFFFF"
                    Foreground="#27343B"
                    BorderBrush="#C9D1CC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Open"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text=">"
                           FontSize="16"
                           FontWeight="SemiBold"/>
              </Grid>
            </Button>
            <StackPanel Spacing="6"
                        Margin="16,0,0,0"
                        IsVisible="{Binding IsOpenSidebarExpanded}">
              <Grid ColumnDefinitions="*,38">
                <TextBox Text="{Binding OpenAlbumLink}"
                         Watermark="Paste album link here"
                         MinHeight="38"
                         Margin="0,0,6,0"/>
                <Button Grid.Column="1"
                        Width="38"
                        Height="38"
                        Padding="0"
                        Background="White"
                        BorderBrush="#C9D1CC"
                        BorderThickness="1"
                        Command="{Binding OpenAlbumFromSidebarCommand}">
                  <TextBlock Text=">"
                             FontSize="18"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding SidebarRecentAlbums}"
                            IsVisible="{Binding HasSidebarRecentAlbums}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentAlbumViewModel">
                    <Button Padding="12"
                            Click="RecentAlbum_Click"
                            HorizontalAlignment="Stretch"
                            Background="White"
                            BorderBrush="#C9D1CC"
                            BorderThickness="1"
                            HorizontalContentAlignment="Stretch">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource SidebarAlbumTemplate}"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Button Command="{Binding ShowSettingsCommand}"
                    Padding="12,10"
                    HorizontalAlignment="Stretch"
                    Background="#FFFFFF"
                    BorderBrush="#C9D1CC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Left">
              <TextBlock Text="Settings"
                         FontSize="15"
                         FontWeight="SemiBold"/>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
