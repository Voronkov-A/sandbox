<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="220"
             x:Class="Picshare.Views.ProgressDialogView"
             x:Name="Root">
  <Grid Background="#80000000">
    <Border Background="White"
            BorderBrush="#D6D8D1"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            Margin="20"
            MaxWidth="520"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontSize="18"
                   FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Message, ElementName=Root}"
                   TextWrapping="Wrap"/>
        <Border Background="#FFF4D6"
                BorderBrush="#D18B00"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                IsVisible="{Binding IsWarningVisible, ElementName=Root}">
          <TextBlock Text="{Binding Warning, ElementName=Root}"
                     Foreground="#7A4A00"
                     TextWrapping="Wrap"/>
        </Border>
        <ProgressBar Minimum="0"
                     Maximum="{Binding Maximum, ElementName=Root}"
                     Value="{Binding Value, ElementName=Root}"
                     Height="10"/>
        <Grid ColumnDefinitions="*,Auto">
          <Button Grid.Column="1"
                  Command="{Binding CancelCommand, ElementName=Root}"
                  Padding="12,8">
            Cancel
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
