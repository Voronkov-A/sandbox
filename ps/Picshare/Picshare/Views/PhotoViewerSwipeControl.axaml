<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Picshare.Views"
             x:Class="Picshare.Views.PhotoViewerSwipeControl"
             x:Name="Wheel"
             x:DataType="views:PhotoViewerSwipeControl"
             Width="144" Height="144">
  <UserControl.Styles>
    <Style Selector="Button.swipe-action">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Button.swipe-action.selected">
      <Setter Property="Background" Value="#27343B"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>
  <Border Background="#EEFFFFFF" BorderBrush="#27343B" BorderThickness="2"
          CornerRadius="72" Padding="10">
    <Grid ColumnDefinitions="40,40,40" RowDefinitions="40,40,40"
          HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="LeftButton" Grid.Row="1" Classes="swipe-action"
              Command="{Binding LeftCommand, ElementName=Wheel}"
              IsEnabled="{Binding CanGoLeft, ElementName=Wheel}"
              AutomationProperties.Name="Go right">
        <Canvas Width="20" Height="20">
          <Path Data="M8,4 L14,10 L8,16"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                StrokeLineCap="Round" StrokeJoin="Round"/>
        </Canvas>
      </Button>
      <Button x:Name="RightButton" Grid.Row="1" Grid.Column="2" Classes="swipe-action"
              Command="{Binding RightCommand, ElementName=Wheel}"
              IsEnabled="{Binding CanGoRight, ElementName=Wheel}"
              AutomationProperties.Name="Go left">
        <Canvas Width="20" Height="20">
          <Path Data="M12,4 L6,10 L12,16"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                StrokeLineCap="Round" StrokeJoin="Round"/>
        </Canvas>
      </Button>
      <Button x:Name="TopButton" Grid.Column="1" Classes="swipe-action"
              Command="{Binding TopCommand, ElementName=Wheel}"
              IsEnabled="{Binding CanMoveTop, ElementName=Wheel}"
              AutomationProperties.Name="Move to Nice">
        <Canvas Width="20" Height="20">
          <Path Data="M5,7 L9,3 L15,3 L18,8 L15,16 L8,18 L3,14 Z M8,8 L8,9 M14,8 L14,9 M8,13 Q11,16 15,13"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                StrokeLineCap="Round" Fill="Transparent"/>
        </Canvas>
      </Button>
      <Button x:Name="BottomButton" Grid.Row="2" Grid.Column="1" Classes="swipe-action"
              Command="{Binding BottomCommand, ElementName=Wheel}"
              IsEnabled="{Binding CanMoveBottom, ElementName=Wheel}"
              AutomationProperties.Name="Move to Good">
        <Canvas Width="20" Height="20">
          <Path Data="M5,7 L9,3 L15,3 L18,8 L15,16 L8,18 L3,14 Z M8,8 L8,9 M14,8 L14,9 M8,14 L15,14"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                StrokeLineCap="Round" Fill="Transparent"/>
        </Canvas>
      </Button>
    </Grid>
  </Border>
</UserControl>
