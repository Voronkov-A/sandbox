<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picshare.ViewModels"
             xmlns:views="clr-namespace:Picshare.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Picshare.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:AlbumPhotoRowViewModel}" x:DataType="vm:AlbumPhotoRowViewModel">
      <ItemsControl ItemsSource="{Binding Photos}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AlbumPhotoViewModel">
            <Border x:Name="AlbumPhotoCard"
                    Width="{Binding CardWidth}"
                    Height="{Binding CardHeight}"
                    Margin="0,0,12,12"
                    Background="White"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="{Binding CardBorderThickness}"
                    CornerRadius="6"
                    Loaded="AlbumPhoto_Loaded"
                    Unloaded="AlbumPhoto_Unloaded"
                    Tapped="AlbumPhotoCard_Tapped">
              <Grid RowDefinitions="*,40">
                <Button Click="AlbumPhoto_Click"
                        Padding="0"
                        Background="#01000000"
                        BorderThickness="0"
                        ClipToBounds="True"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                  <Border Background="#01000000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <Image Source="{Binding Image}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RenderTransformOrigin="50%,50%">
                      <Image.RenderTransform>
                        <RotateTransform Angle="{Binding RotationDegrees}"/>
                      </Image.RenderTransform>
                    </Image>
                  </Border>
                </Button>
                <Grid Width="70"
                      Height="36"
                      Margin="6"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsScoreVisible}">
                  <Grid ColumnDefinitions="32,Auto"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                    <Grid Width="32" Height="32">
                      <TextBlock Text="👍" FontSize="25" Foreground="Black" Margin="-1,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="👍" FontSize="25" Foreground="Black" Margin="1,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="👍" FontSize="25" Foreground="Black" Margin="-1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="👍" FontSize="25" Foreground="Black" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="👍" FontSize="25" Foreground="#FFD84D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Column="1"
                            MinWidth="32"
                            Height="20"
                            Padding="4,0"
                            Background="#EFFFFFFF"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="-2,6,0,0"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding ScoreText}"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Grid>
                <Border Width="72"
                        Height="54"
                        Margin="0,0,8,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#E627343B"
                        BorderBrush="White"
                        BorderThickness="1"
                        IsVisible="{Binding HasDuplicateGroup}">
                  <Grid>
                    <Border Margin="8,4,0,0"
                            Background="#9AD9E5E8"
                            BorderBrush="#27343B"
                            BorderThickness="1"/>
                    <Border Margin="4,8,4,4"
                            Background="#D9FFFFFF"
                            BorderBrush="#27343B"
                            BorderThickness="1"
                            ClipToBounds="True">
                      <Image Source="{Binding DuplicateStackPhoto.Image}"
                             Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding DuplicateGroupCountText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <Border Width="22"
                            Height="22"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#1E8E3E"
                            BorderBrush="White"
                            BorderThickness="1"
                            IsVisible="{Binding IsBestMarkerVisible}">
                      <TextBlock Text="V"
                                 Foreground="White"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
                <Button HorizontalAlignment="Right"
                        x:Name="AlbumPhotoSelectionButton"
                        VerticalAlignment="Top"
                        MinWidth="38"
                        Height="32"
                        Margin="0,6,6,0"
                        Padding="8,4"
                        Click="AlbumPhotoSelection_Click"
                        Background="{Binding SelectionBackground}"
                        Foreground="{Binding SelectionForeground}"
                        BorderBrush="#27343B"
                        BorderThickness="1">
                  <TextBlock Text="{Binding SelectionGlyph}" FontWeight="SemiBold"/>
                </Button>
                <Border Grid.Row="1" Background="#F2F2EE" Padding="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding FileName}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="..."
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#7B4B39"
                               ToolTip.Tip="Loading image"
                               IsVisible="{Binding IsImageLoading}"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AlbumPhotoGroupHeaderViewModel}" x:DataType="vm:AlbumPhotoGroupHeaderViewModel">
      <TextBlock x:Name="AlbumPhotoGroupHeader"
                 Text="{Binding Header}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="#27343B"
                 Margin="0,0,0,8"/>
    </DataTemplate>
  </UserControl.DataTemplates>



  <UserControl.Styles>
    <Style Selector="Button.footer-action">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6D8D1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.review-tab-header">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#27343B"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.review-tab-header:pointerover">
      <Setter Property="Background" Value="#EDF0ED"/>
      <Setter Property="BorderBrush" Value="#D6D8D1"/>
    </Style>
    <Style Selector="Button.review-tab-header.selected-review-tab">
      <Setter Property="Background" Value="#27343B"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#27343B"/>
    </Style>
    <Style Selector="ListBox.album-photo-list ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ListBox.album-photo-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.album-photo-list ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.album-photo-list ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootLayout" Background="#F7F7F4" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <views:MainHeaderView x:Name="MainHeader"
                          Grid.Row="0">
      <views:MainHeaderView.RenderTransform>
        <TranslateTransform/>
      </views:MainHeaderView.RenderTransform>
    </views:MainHeaderView>

    <Grid Grid.Row="1" Grid.RowSpan="2">
      <views:LazyControlHost IsActive="{Binding IsCreateViewVisible}"
                             ControlType="{x:Type views:CreateAlbumView}"
                             KeepAlive="True"/>

      <Grid x:Name="OpenAlbumLayout"
            IsVisible="{Binding IsOpenViewVisible}"
            ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="AlbumReviewTabHeader"
                Grid.Row="0"
                Background="White"
                BorderBrush="#D6D8D1"
                BorderThickness="0,0,0,1">
          <Border.RenderTransform>
            <TranslateTransform/>
          </Border.RenderTransform>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
            <Button x:Name="AlbumReviewTabsScrollLeftButton"
                    Grid.Column="0"
                    Width="42"
                    Height="42"
                    Padding="0"
                    Margin="0,0,8,0"
                    Click="ScrollAlbumReviewTabsLeft_Click"
                    ToolTip.Tip="Scroll tabs left"
                    VerticalAlignment="Center">
              <TextBlock Text="&lt;"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Button>
            <ScrollViewer x:Name="AlbumReviewTabHeaderScrollViewer"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="AlbumReviewTabHeaderScrollViewer_ScrollChanged"
                          SizeChanged="AlbumReviewTabHeaderScrollViewer_SizeChanged"
                          VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsUncategorizedReviewTabSelected}"
                        Content="{Binding UncategorizedTabHeader}"
                        Tag="uncategorized"
                        Click="AlbumReviewTabHeader_Click"/>
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsNiceReviewTabSelected}"
                        Content="{Binding NiceTabHeader}"
                        Tag="nice"
                        Click="AlbumReviewTabHeader_Click"/>
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsOkReviewTabSelected}"
                        Content="{Binding OkTabHeader}"
                        Tag="ok"
                        Click="AlbumReviewTabHeader_Click"/>
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsTrashReviewTabSelected}"
                        Content="{Binding TrashTabHeader}"
                        Tag="trash"
                        Click="AlbumReviewTabHeader_Click"/>
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsUnresolvedDuplicatesReviewTabSelected}"
                        Content="{Binding UnresolvedDuplicatesTabHeader}"
                        Tag="unresolved-duplicates"
                        IsVisible="{Binding HasUnresolvedDuplicatePhotos}"
                        Click="AlbumReviewTabHeader_Click"/>
                <Button Classes="review-tab-header"
                        Classes.selected-review-tab="{Binding IsFlowReviewTabSelected}"
                        Content="{Binding FlowTabHeader}"
                        Tag="flow"
                        IsVisible="{Binding IsFlowReviewTabVisible}"
                        Click="AlbumReviewTabHeader_Click"/>
              </StackPanel>
            </ScrollViewer>
            <Button x:Name="AlbumReviewTabsScrollRightButton"
                    Grid.Column="2"
                    Width="42"
                    Height="42"
                    Padding="0"
                    Margin="8,0,0,0"
                    Click="ScrollAlbumReviewTabsRight_Click"
                    ToolTip.Tip="Scroll tabs right"
                    VerticalAlignment="Center">
              <TextBlock Text="&gt;"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Button>
          </Grid>
        </Border>
        <Grid x:Name="AlbumReviewContentHost"
              Grid.Row="1"
              Margin="20,0,20,20"
              SizeChanged="AlbumReviewContentHost_SizeChanged">
          <Grid IsVisible="{Binding IsUncategorizedReviewTabSelected}">
                  <ListBox ItemsSource="{Binding UncategorizedPhotoGroups}"
                           Classes="album-photo-list"
                           Loaded="AlbumPhotoList_Loaded"
                           Unloaded="AlbumPhotoList_Unloaded"
                           SelectionChanged="AlbumPhotoList_SelectionChanged"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
          </Grid>
          <Grid IsVisible="{Binding IsNiceReviewTabSelected}">
                  <ListBox ItemsSource="{Binding NicePhotoGroups}"
                           Classes="album-photo-list"
                           Loaded="AlbumPhotoList_Loaded"
                           Unloaded="AlbumPhotoList_Unloaded"
                           SelectionChanged="AlbumPhotoList_SelectionChanged"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
          </Grid>
          <Grid IsVisible="{Binding IsOkReviewTabSelected}">
                  <ListBox ItemsSource="{Binding OkPhotoGroups}"
                           Classes="album-photo-list"
                           Loaded="AlbumPhotoList_Loaded"
                           Unloaded="AlbumPhotoList_Unloaded"
                           SelectionChanged="AlbumPhotoList_SelectionChanged"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
          </Grid>
          <Grid IsVisible="{Binding IsTrashReviewTabSelected}">
                  <ListBox ItemsSource="{Binding TrashPhotoGroups}"
                           Classes="album-photo-list"
                           Loaded="AlbumPhotoList_Loaded"
                           Unloaded="AlbumPhotoList_Unloaded"
                           SelectionChanged="AlbumPhotoList_SelectionChanged"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
          </Grid>
          <Grid IsVisible="{Binding IsUnresolvedDuplicatesReviewTabSelected}">
                  <ListBox ItemsSource="{Binding UnresolvedDuplicatePhotoGroups}"
                           Classes="album-photo-list"
                           Loaded="AlbumPhotoList_Loaded"
                           Unloaded="AlbumPhotoList_Unloaded"
                           SelectionChanged="AlbumPhotoList_SelectionChanged"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
          </Grid>
          <Border x:Name="StickyAlbumPhotoGroupHeader"
                  Background="#F7F7F4"
                  BorderBrush="#D6D8D1"
                  BorderThickness="0,0,0,1"
                  Padding="0,0,0,8"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  IsVisible="False"
                  ZIndex="5">
            <TextBlock x:Name="StickyAlbumPhotoGroupHeaderText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#27343B"/>
          </Border>
          <Grid IsVisible="{Binding IsFlowReviewTabSelected}">
                  <ScrollViewer>
                    <StackPanel Spacing="16">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Text="{Binding FlowStatus}"
                                   Foreground="#6C756F"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding CollectFeedbackCommand}"
                                IsVisible="{Binding IsCollectFeedbackVisible}"
                                IsEnabled="{Binding CanCollectFeedback}"
                                Margin="0,0,8,0"
                                Padding="12,8">
                          Collect the feedback
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding StartNextRoundCommand}"
                                IsVisible="{Binding CanStartNextRound}"
                                IsEnabled="{Binding CanStartNextRound}"
                                Margin="0,0,8,0"
                                Padding="12,8">
                          Next round
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding ApplyRandomVerdictCommand}"
                                IsVisible="{Binding CanApplyRandomVerdict}"
                                IsEnabled="{Binding CanApplyRandomVerdict}"
                                Margin="0,0,8,0"
                                Padding="12,8">
                          Random verdict
                        </Button>
                        <Button Grid.Column="4"
                                Command="{Binding FinalizeFeedbackCommand}"
                                IsVisible="{Binding CanFinalizeFeedback}"
                                IsEnabled="{Binding CanFinalizeFeedback}"
                                Margin="0,0,8,0"
                                Padding="12,8">
                          Finalize
                        </Button>
                        <Button Grid.Column="5"
                                Command="{Binding DeleteAlbumCommand}"
                                IsVisible="{Binding CanDeleteAlbum}"
                                IsEnabled="{Binding CanDeleteAlbum}"
                                Background="#B42318"
                                Foreground="White"
                                BorderBrush="#7A271A"
                                Padding="12,8">
                          Delete the album
                        </Button>
                      </Grid>
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding WorkflowHistoryHeader}" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding WorkflowHistory}"
                                 Background="Transparent"
                                 BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowHistoryEntryViewModel">
                              <Border Background="White"
                                      BorderBrush="#D6D8D1"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="12"
                                      Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Timestamp}"
                                             FontSize="12"
                                             Foreground="#6C756F"
                                             Margin="12,0,0,0"/>
                                  <TextBlock Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Text="{Binding Description}"
                                             FontSize="12"
                                             Foreground="#6C756F"
                                             IsVisible="{Binding HasDescription}"
                                             Margin="0,4,0,0"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                      <StackPanel Spacing="6" IsVisible="{Binding IsRegularFlowVisible}">
                        <TextBlock Text="{Binding CommittedReviewersHeader}" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding CommittedReviewers}"
                                 Background="Transparent"
                                 BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewerFeedbackFlowItemViewModel">
                              <Border Background="White"
                                      BorderBrush="#D6D8D1"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="12"
                                      Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6C756F"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                      <StackPanel Spacing="6" IsVisible="{Binding IsRegularFlowVisible}">
                        <TextBlock Text="{Binding PassedReviewersHeader}" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding PassedReviewers}"
                                 Background="Transparent"
                                 BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewerFeedbackFlowItemViewModel">
                              <Border Background="White"
                                      BorderBrush="#D6D8D1"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="12"
                                      Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6C756F"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                      <StackPanel Spacing="6" IsVisible="{Binding IsAuthorFlowVisible}">
                        <TextBlock Text="{Binding LeftReviewersHeader}" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding LeftReviewers}"
                                 Background="Transparent"
                                 BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewerFeedbackFlowItemViewModel">
                              <Border Background="White"
                                      BorderBrush="#D6D8D1"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="12"
                                      Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6C756F"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding InProgressReviewersHeader}" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding InProgressReviewers}"
                                 Background="Transparent"
                                 BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewerFeedbackFlowItemViewModel">
                              <Border Background="White"
                                      BorderBrush="#D6D8D1"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="12"
                                      Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6C756F"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
          </Grid>
              <Button Grid.Row="1"
                      Width="38"
                      Height="34"
                      Padding="0"
                      Margin="0,2,12,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Command="{Binding ToggleBulkPhotoActionPanelCommand}"
                      IsVisible="{Binding IsBulkPhotoActionPanelToggleVisible}"
                      Background="White"
                      Foreground="Black"
                      BorderBrush="#27343B"
                      BorderThickness="1"
                      ToolTip.Tip="Selection actions">
                <Grid Width="22" Height="22">
                  <TextBlock Text="..." FontSize="20" FontWeight="Bold" Foreground="#27343B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Button>
          </Grid>
      </Grid>
      <views:LazyControlHost x:Name="SettingsViewHost"
                             IsActive="{Binding IsSettingsViewVisible}"
                             ControlType="{x:Type views:SettingsView}"
                             KeepAlive="True"/>
    </Grid>

    <views:LazyControlHost x:Name="ImageListFooterHost"
                           Grid.Row="2"
                           IsActive="{Binding IsImageListFooterVisible}"
                           ControlType="{x:Type views:ImageListFooterView}"
                           KeepAlive="True">
      <views:LazyControlHost.RenderTransform>
        <TranslateTransform/>
      </views:LazyControlHost.RenderTransform>
    </views:LazyControlHost>


    <views:LazyControlHost Grid.RowSpan="4"
                           IsActive="{Binding IsSidebarOpen}"
                           ControlType="{x:Type views:SidebarView}"
                           KeepAlive="True"
                           ZIndex="20"/>

    <ProgressBar Grid.Row="3"
                 IsIndeterminate="{Binding IsBusy}"
                 Height="3"
                 Minimum="0"
                 Maximum="1"
                 Value="0"/>

    <views:LazyControlHost Grid.RowSpan="3"
                           IsActive="{Binding IsAlbumModalDialogsVisible}"
                           ControlType="{x:Type views:AlbumModalDialogsView}"/>

    <views:LazyControlHost Grid.RowSpan="4"
                           IsActive="{Binding IsPhotoViewerVisible}"
                           ControlType="{x:Type views:PhotoViewerView}"/>
  </Grid>
</UserControl>
