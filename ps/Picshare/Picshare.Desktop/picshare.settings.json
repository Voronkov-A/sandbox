{
  "ai": {
    "model": "gpt-6-luna",
    "batchSize": 50,
    "maxImageDimension": 512
  },
  "google": {
    "oauthClientId": "<oauthClientId>",
    "oauthClientSecret": "<oauthClientSecret>"
  },
  "defaultSettings": {
    "fixedHeader": true,
    "fixedTabs": true,
    "fixedActionPanel": true,
    "showPhotoViewerPreviousNextButtons": true,
    "categoryButtons": true,
    "rotationButtons": true,
    "preloadImagesWhileScrolling": false
  }
}
